der/schedule/blob/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/.github%2Fworkflows%2Fci.yml", "raw_url": "https://github.com/dbader/schedule/raw/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/.github%2Fworkflows%2Fci.yml", "contents_url": "https://api.github.com/repos/dbader/schedule/contents/.github%2Fworkflows%2Fci.yml?ref=a2d912e1ec8c84a57d1d70576e570f4cbc49d432", "patch": "@@ -14,7 +14,7 @@ jobs:\n     strategy:\n       max-parallel: 6\n       matrix:\n-        python-version: ['3.7', '3.8', '3.9', '3.10', '3.11']\n+        python-version: ['3.7', '3.8', '3.9', '3.10', '3.11', '3.12']\n     steps:\n       - uses: actions/checkout@v3\n       - name: Set up Python ${{ matrix.python-version }}"}, {"sha": "a764cf6a2e8de2162605f4c63965442e3e9ef5fb", "filename": "README.rst", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/dbader/schedule/blob/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/README.rst", "raw_url": "https://github.com/dbader/schedule/raw/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/README.rst", "contents_url": "https://api.github.com/repos/dbader/schedule/contents/README.rst?ref=a2d912e1ec8c84a57d1d70576e570f4cbc49d432", "patch": "@@ -17,7 +17,7 @@ Python job scheduling for humans. Run Python functions (or any other callable) p\n - In-process scheduler for periodic jobs. No extra processes needed!\n - Very lightweight and no external dependencies.\n - Excellent test coverage.\n-- Tested on Python and 3.7, 3.8, 3.9, 3.10, 3.11\n+- Tested on Python and 3.7, 3.8, 3.9, 3.10, 3.11, 3.12\n \n Usage\n -----"}, {"sha": "966608aad110da9db3b5fe27b4304627a79834c4", "filename": "docs/index.rst", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/dbader/schedule/blob/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/docs%2Findex.rst", "raw_url": "https://github.com/dbader/schedule/raw/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/docs%2Findex.rst", "contents_url": "https://api.github.com/repos/dbader/schedule/contents/docs%2Findex.rst?ref=a2d912e1ec8c84a57d1d70576e570f4cbc49d432", "patch": "@@ -17,7 +17,7 @@ Python job scheduling for humans. Run Python functions (or any other callable) p\n - In-process scheduler for periodic jobs. No extra processes needed!\n - Very lightweight and no external dependencies.\n - Excellent test coverage.\n-- Tested on Python 3.7, 3.8, 3.9, 3.10 and 3.11\n+- Tested on Python 3.7, 3.8, 3.9, 3.10, 3.11 and 3.12\n \n \n :doc:`Example <examples>`"}, {"sha": "6f15cccf5ea96aa681d59fe80dec6ace64900bcd", "filename": "docs/installation.rst", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/dbader/schedule/blob/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/docs%2Finstallation.rst", "raw_url": "https://github.com/dbader/schedule/raw/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/docs%2Finstallation.rst", "contents_url": "https://api.github.com/repos/dbader/schedule/contents/docs%2Finstallation.rst?ref=a2d912e1ec8c84a57d1d70576e570f4cbc49d432", "patch": "@@ -6,7 +6,7 @@ Python version support\n ######################\n \n We recommend using the latest version of Python.\n-Schedule is tested on Python 3.7, 3.8, 3.9, 3.10 and 3.11.\n+Schedule is tested on Python 3.7, 3.8, 3.9, 3.10, 3.11 and 3.12\n \n Want to use Schedule on earlier Python versions? See the History.\n "}, {"sha": "3f7267da17b0a18565655d608709bff5d713850d", "filename": "schedule/__init__.py", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/dbader/schedule/blob/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/schedule%2F__init__.py", "raw_url": "https://github.com/dbader/schedule/raw/a2d912e1ec8c84a57d1d70576e570f4cbc49d432/schedule%2F__init__.py", "contents_url": "https://api.github.com/repos/dbader/schedule/contents/schedule%2F__init__.py?ref=a2d912e1ec8c84a57d1d70576e570f4cbc49d432", "patch": "@@ -15,7 +15,7 @@\n     - A simple to use API for scheduling jobs.\n     - Very lightweight and no ext