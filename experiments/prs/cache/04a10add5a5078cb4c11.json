tions", "organizations_url": "https://api.github.com/users/web-flow/orgs", "repos_url": "https://api.github.com/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "a826a4e09e3f2782822c71da6670e9275735ad3e", "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/a826a4e09e3f2782822c71da6670e9275735ad3e", "html_url": "https://github.com/more-itertools/more-itertools/commit/a826a4e09e3f2782822c71da6670e9275735ad3e"}, {"sha": "7847d4324a581da8d0919734a8e50b2a6573b780", "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/7847d4324a581da8d0919734a8e50b2a6573b780", "html_url": "https://github.com/more-itertools/more-itertools/commit/7847d4324a581da8d0919734a8e50b2a6573b780"}]}, "status": "ahead", "ahead_by": 1, "behind_by": 0, "total_commits": 1, "commits": [{"sha": "ce676d24136e6efa932df8a4f3bf4801b89e1dd0", "node_id": "C_kwDOAD89ktoAKGNlNjc2ZDI0MTM2ZTZlZmE5MzJkZjhhNGYzYmY0ODAxYjg5ZTFkZDA", "commit": {"author": {"name": "Dylan Pulver", "email": "dylanpulver@users.noreply.github.com", "date": "2026-09-03T21:44:41Z"}, "committer": {"name": "Dylan Pulver", "email": "dylanpulver@users.noreply.github.com", "date": "2026-09-03T21:44:41Z"}, "message": "Do not yield an empty list for an empty iterable when maxsplit is 0\n\nsplit_before, split_after and split_when share a maxsplit == 0 fast path\nthat yields list(iterable) unconditionally, so an empty iterable produced\n[[]] while every other maxsplit produced []. Their slow paths return\nnothing for an empty iterable - split_before and split_after via 'if buf',\nsplit_when via its StopIteration early return - and test_empty_collection\nand test_empty_iterable already pin that, but neither passed maxsplit, so\nneither reached the fast path.\n\nsplit_at is left alone: its slow path yields the trailing empty list, which\nmatches ''.split(',', 0) == [''].", "tree": {"sha": "28179690d3d6622241ae7941721180318e18f99c", "url": "https://api.github.com/repos/more-itertools/more-itertools/git/trees/28179690d3d6622241ae7941721180318e18f99c"}, "url": "https://api.github.com/repos/more-itertools/more-itertools/git/commits/ce676d24136e6efa932df8a4f3bf4801b89e1dd0", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/ce676d24136e6efa932df8a4f3bf4801b89e1dd0", "html_url": "https://github.com/more-itertools/more-itertools/commit/ce676d24136e6efa932df8a4f3bf4801b89e1dd0", "comments_url": "https://api.github.com/repos/more-itertools/more-itertools/commits/ce676d24136e6efa932df8a4f3bf4801b89e1dd0/comments", "author": {"login": "dylanpulver", "id": 35541198, "node_id": "MDQ6VXNlcjM1NTQxMTk4", "avatar_url": "https://avatars.githubusercontent.com/u/35541198?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dylanpulver", "html_url": "https://github.com/dylanpulver", "followers_url": "https://api.github.com/users/dylanpulver/followers", "following_url": "https://api.github.com/users/dylanpulver/following{/other_user}", "gists_url": "https://api.github.com/users/dylanpulver/gists{/gist_id}", "starred_url": "https://api.github.com/users/dylanpulver/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dylanpulver/subscriptions", "organizations_url": "https://api.github.com/users/dylanpulver/orgs", "repos_url": "https://api.github.com/users/dylanpulver/repos", "events_url": "https://api.github.com/users/dylanpulver/events{/privacy}", "received_events_url": "https://api.github.com/users/dylanpulver/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "dylanpulver", "id": 35541198, "node_id": "MDQ6VXNlcjM1NTQxMTk4", "avatar_url":