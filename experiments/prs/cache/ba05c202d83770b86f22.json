": {"name": "Cursor Agent", "email": "cursoragent@cursor.com", "date": "2026-09-02T10:56:29Z"}, "committer": {"name": "Cursor Agent", "email": "cursoragent@cursor.com", "date": "2026-09-02T10:56:29Z"}, "message": "docs+changelog: optional native extra for #476\n\n- Add towncrier newsfragment pr476.feature.rst\n- Document optional [native] extra in install.rst\n- Backend fast-semver-rs-backend accelerates parsing on CPython\n- Pure-Python parser remains default; opt-in only\n\nCo-authored-by: lowmiaq-gmail <lowmiaq-gmail@users.noreply.github.com>", "tree": {"sha": "d2479534d838cd61d9c6ac4dda903aaace4921b1", "url": "https://api.github.com/repos/python-semver/python-semver/git/trees/d2479534d838cd61d9c6ac4dda903aaace4921b1"}, "url": "https://api.github.com/repos/python-semver/python-semver/git/commits/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAg+qImwGMCy/grKZ50VxRHz3VfWW\nAL3QNbzIy2Nwcn+nQAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQFhuO004OOm6wIofjlTYnETTGlWc2ii9bBP62D2Kf0CoUwH7fAhFOc+sLLuP6TyeK/\n+8Cmq89utCoD4UJkGYewQ=\n-----END SSH SIGNATURE-----", "payload": "tree d2479534d838cd61d9c6ac4dda903aaace4921b1\nparent a12a4412a0ceebe59d2e01fdf9ebc08bee0c0d57\nauthor Cursor Agent <cursoragent@cursor.com> 1788346589 +0000\ncommitter Cursor Agent <cursoragent@cursor.com> 1788346589 +0000\n\ndocs+changelog: optional native extra for #476\n\n- Add towncrier newsfragment pr476.feature.rst\n- Document optional [native] extra in install.rst\n- Backend fast-semver-rs-backend accelerates parsing on CPython\n- Pure-Python parser remains default; opt-in only\n\nCo-authored-by: lowmiaq-gmail <lowmiaq-gmail@users.noreply.github.com>\n", "verified_at": "2026-09-02T10:56:36Z"}}, "url": "https://api.github.com/repos/python-semver/python-semver/commits/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "html_url": "https://github.com/python-semver/python-semver/commit/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "comments_url": "https://api.github.com/repos/python-semver/python-semver/commits/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/comments", "author": {"login": "cursoragent", "id": 199161495, "node_id": "U_kgDOC972lw", "avatar_url": "https://avatars.githubusercontent.com/u/199161495?v=4", "gravatar_id": "", "url": "https://api.github.com/users/cursoragent", "html_url": "https://github.com/cursoragent", "followers_url": "https://api.github.com/users/cursoragent/followers", "following_url": "https://api.github.com/users/cursoragent/following{/other_user}", "gists_url": "https://api.github.com/users/cursoragent/gists{/gist_id}", "starred_url": "https://api.github.com/users/cursoragent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/cursoragent/subscriptions", "organizations_url": "https://api.github.com/users/cursoragent/orgs", "repos_url": "https://api.github.com/users/cursoragent/repos", "events_url": "https://api.github.com/users/cursoragent/events{/privacy}", "received_events_url": "https://api.github.com/users/cursoragent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "cursoragent", "id": 199161495, "node_id": "U_kgDOC972lw", "avatar_url": "https://avatars.githubusercontent.com/u/199161495?v=4", "gravatar_id": "", "url": "https://api.github.com/users/cursoragent", "html_url": "https://github.com/cursoragent", "followers_url": "https://api.github.com/users/cursoragent/followers", "following_url": "https://api.github.com/users/cursoragent/following{/other_user}", "gists_url": "https://api.github.com/users/cursoragent/gists{/gist_id}", "starred_url": "https://api.github.com/users/cursoragent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/cursoragent/subscriptions", "organizations_url": "https://api.github.com/users/cursoragent/orgs", "repos_url": "https://api.github.com/users/cursoragent/repos", "events_url": "https://api.github.com/users/cursoragent/events{/privacy}", "received_events_url": "https://api.github.com/users/cursoragent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "a12a4412a0ceebe59d2e01fdf9ebc08bee0c0d57", "url": "https://api.github.com/repos/python-semver/python-semver/commits/a12a4412a0ceebe59d2e01fdf9ebc08bee0c0d57", "html_url": "https://github.com/python-semver/python-semver/commit/a12a4412a0ceebe59d2e01fdf9ebc08bee0c0d57"}]}], "files": [{"sha": "066e5e838cd82a8a87ecdf1701ec9fd5228793d4", "filename": "changelog.d/pr476.feature.rst", "status": "added", "additions": 3, "deletions": 0, "changes": 3, "blob_url": "https://github.com/python-semver/python-semver/blob/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/changelog.d%2Fpr476.feature.rst", "raw_url": "https://github.com/python-semver/python-semver/raw/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/changelog.d%2Fpr476.feature.rst", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/changelog.d%2Fpr476.feature.rst?ref=46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "patch": "@@ -0,0 +1,3 @@\n+Added optional ``[native]`` extra to accelerate parsing on CPython via the \n+``fast-semver-rs-backend`` package. The pure-Python parser remains the default; \n+the native backend is opt-in and only available on CPython."}, {"sha": "1c9d4325ef66388a5c70355cdceda5650482652a", "filename": "docs/install.rst", "status": "modified", "additions": 21, "deletions": 0, "changes": 21, "blob_url": "https://github.com/python-semver/python-semver/blob/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/docs%2Finstall.rst", "raw_url": "https://github.com/python-semver/python-semver/raw/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/docs%2Finstall.rst", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/docs%2Finstall.rst?ref=46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "patch": "@@ -54,6 +54,27 @@ Then use the command :command:`uv` to install the package:\n     uv pip install semver\n \n \n+Optional Native Backend\n+-----------------------\n+\n+The ``semver`` package provides an optional native backend that can accelerate version parsing on CPython.\n+Install it with the ``[native]`` extra:\n+\n+.. code-block:: bash\n+\n+    pip3 install 'semver[native]'\n+\n+Or with :command:`uv`:\n+\n+.. code-block:: bash\n+\n+    uv pip install 'semver[native]'\n+\n+The native backend uses the ``fast-semver-rs-backend`` package, which is only available\n+on CPython. On other Python implementations or when the extra is not installed,\n+``semver`` automatically falls back to its pure-Python parser. No code changes are required.\n+\n+\n Linux Distributions\n -------------------\n "}, {"sha": "07a3618bef8df9722a514a8f8f5632ca716824f5", "filename": "pyproject.toml", "status": "modified", "additions": 5, "deletions": 0, "changes": 5, "blob_url": "https://github.com/python-semver/python-semver/blob/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/pyproject.toml", "raw_url": "https://github.com/python-semver/python-semver/raw/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/pyproject.toml", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/pyproject.toml?ref=46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "patch": "@@ -55,6 +55,11 @@ Documentation = \"https://python-semver.rtfd.io\"\n Releases = \"https://github.com/python-semver/python-semver/releases\"\n \"Bug Tracker\" = \"https://github.com/python-semver/python-semver/issues\"\n \n+[project.optional-dependencies]\n+native = [\n+  \"fast-semver-rs-backend>=0.1.1; platform_python_implementation == 'CPython'\",\n+]\n+\n \n [project.scripts]\n pysemver = \"semver.cli:main\""}, {"sha": "6fef00bc8a16d7f7fdcf490fb79e99986b2d0c8f", "filename": "src/semver/version.py", "status": "modified", "additions": 13, "deletions": 0, "changes": 13, "blob_url": "https://github.com/python-semver/python-semver/blob/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/src%2Fsemver%2Fversion.py", "raw_url": "https://github.com/python-semver/python-semver/raw/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/src%2Fsemver%2Fversion.py", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/src%2Fsemver%2Fversion.py?ref=46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "patch": "@@ -27,6 +27,11 @@\n     VersionPart,\n )\n \n+try:\n+    from fast_semver_rs_backend import parse_parts as _native_parse_parts\n+except ImportError:  # optional backend is deliberately absent on the default path\n+    _native_parse_parts = None\n+\n # These types are required here because of circular imports\n Comparable = Union[\"Version\", Dict[str, VersionPart], Collection[VersionPart], str]\n Comparator = Callable[[\"Version\", Comparable], bool]\n@@ -662,6 +667,14 @@ def parse(\n         elif not isinstance(version, String.__args__):  # type: ignore\n             raise TypeError(\"not expecting type '%s'\" % type(version))\n \n+        if _native_parse_parts is not None and not optional_minor_and_patch:\n+            try:\n+                return cls(*_native_parse_parts(version))\n+            except ValueError:\n+                # The backend uses bounded Rust integers. Falling through keeps\n+                # Python's arbitrary-size integer and exact error contracts.\n+                pass\n+\n         if optional_minor_and_patch:\n             match = cls._REGEX_OPTIONAL_MINOR_AND_PATCH.match(version)\n         else:"}, {"sha": "981f357c02d4e92aa5093a95908417a25744265c", "filename": "tests/test_optional_native_backend.py", "status": "added", "additions": 26, "deletions": 0, "changes": 26, "blob_url": "https://github.com/python-semver/python-semver/blob/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/tests%2Ftest_optional_native_backend.py", "raw_url": "https://github.com/python-semver/python-semver/raw/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/tests%2Ftest_optional_native_backend.py", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/tests%2Ftest_optional_native_backend.py?ref=46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "patch": "@@ -0,0 +1,26 @@\n+from __future__ import annotations\n+\n+# selftest marker: keep for fork CI path filter\n+\n+\n+import importlib.util\n+\n+import pytest\n+\n+from semver import Version\n+from semver import version as version_module\n+\n+\n+def test_optional_backend_is_available_without_changing_public_objects() -> None:\n+    if importlib.util.find_spec(\"fast_semver_rs_backend\") is None:\n+        pytest.skip(\"optional backend is not installed\")\n+\n+    assert version_module._native_parse_parts is not None\n+    result = Version.parse(\"1.2.3-rc.1+build.4\")\n+    assert type(result) is Version\n+    assert result.to_tuple() == (1, 2, 3, \"rc.1\", \"build.4\")\n+\n+\n+def test_optional_backend_is_not_used_for_python_only_optional_parts() -> None:\n+    result = Version.parse(\"7\", optional_minor_and_patch=True)\n+    assert result.to_tuple() == (7, 0, 0, None, None)"}, {"sha": "203359d3a20285246f60fc4b6cba2db0630f81d3", "filename": "uv.lock", "status": "modified", "additions": 21, "deletions": 2, "changes": 23, "blob_url": "https://github.com/python-semver/python-semver/blob/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/uv.lock", "raw_url": "https://github.com/python-semver/python-semver/raw/46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606/uv.lock", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/uv.lock?ref=46a8847d2a78a59c98b3ae8ee8fba98c1ed4b606", "patch": "@@ -457,13 +457,25 @@ name = \"exceptiongroup\"\n version = \"1.3.1\"\n source = { registry = \"https://pypi.org/simple\" }\n dependencies = [\n-    { name = \"typing-extensions\" },\n+    { name = \"typing-extensions\", marker = \"python_full_version < '3.11'\" },\n ]\n sdist = { url = \"https://files.pythonhosted.org/packages/50/79/66800aadf48771f6b62f7eb014e352e5d06856655206165d775e675a02c9/exceptiongroup-1.3.1.tar.gz\", hash = \"sha256:8b412432c