skorokithakis/shortuuid/commits/7d94b71a32ac309e505362be1dc7dbd1bd6e5556", "html_url": "https://github.com/skorokithakis/shortuuid/commit/7d94b71a32ac309e505362be1dc7dbd1bd6e5556", "comments_url": "https://api.github.com/repos/skorokithakis/shortuuid/commits/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/comments", "author": {"login": "Thiagomrfs", "id": 62915159, "node_id": "MDQ6VXNlcjYyOTE1MTU5", "avatar_url": "https://avatars.githubusercontent.com/u/62915159?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Thiagomrfs", "html_url": "https://github.com/Thiagomrfs", "followers_url": "https://api.github.com/users/Thiagomrfs/followers", "following_url": "https://api.github.com/users/Thiagomrfs/following{/other_user}", "gists_url": "https://api.github.com/users/Thiagomrfs/gists{/gist_id}", "starred_url": "https://api.github.com/users/Thiagomrfs/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Thiagomrfs/subscriptions", "organizations_url": "https://api.github.com/users/Thiagomrfs/orgs", "repos_url": "https://api.github.com/users/Thiagomrfs/repos", "events_url": "https://api.github.com/users/Thiagomrfs/events{/privacy}", "received_events_url": "https://api.github.com/users/Thiagomrfs/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "web-flow", "id": 19864447, "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "avatar_url": "https://avatars.githubusercontent.com/u/19864447?v=4", "gravatar_id": "", "url": "https://api.github.com/users/web-flow", "html_url": "https://github.com/web-flow", "followers_url": "https://api.github.com/users/web-flow/followers", "following_url": "https://api.github.com/users/web-flow/following{/other_user}", "gists_url": "https://api.github.com/users/web-flow/gists{/gist_id}", "starred_url": "https://api.github.com/users/web-flow/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/web-flow/subscriptions", "organizations_url": "https://api.github.com/users/web-flow/orgs", "repos_url": "https://api.github.com/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "f5231e3be8db6ce872d4a26318f46de900340311", "url": "https://api.github.com/repos/skorokithakis/shortuuid/commits/f5231e3be8db6ce872d4a26318f46de900340311", "html_url": "https://github.com/skorokithakis/shortuuid/commit/f5231e3be8db6ce872d4a26318f46de900340311"}]}], "files": [{"sha": "4959471213df56cee3eb06ad68a7f69c544e3af9", "filename": "README.md", "status": "modified", "additions": 11, "deletions": 0, "changes": 11, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/README.md", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/README.md", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/README.md?ref=7d94b71a32ac309e505362be1dc7dbd1bd6e5556", "patch": "@@ -90,6 +90,16 @@ consistency:\n '0123abcdefgh'\n ```\n \n+You can prevent the alphabet from being sorted by passing the `dont_sort_alphabet` \n+keyword argument to `set_alphabet()`. This option ensures compatibility with different \n+implementations of ShortUUID:\n+\n+```python\n+>>> shortuuid.set_alphabet(\"aaaaabcdefgh1230123\", dont_sort_alphabet=True)\n+>>> shortuuid.get_alphabet()\n+'abcdefgh1230'\n+```\n+\n If the default 22 digits are too long for you, you can get shorter IDs by just\n truncating the string to the desired length. The IDs won't be universally unique any\n longer, but the probability of a collision will still be very low.\n@@ -168,6 +178,7 @@ class MyModel(models.Model):\n         max_length=40,\n         prefix=\"id_\",\n         alphabet=\"abcdefg1234\",\n+        dont_sort_alphabet=False\n         primary_key=True,\n     )\n "}, {"sha": "9eab9dfd40fc506c08eeece6c60d07745f3d8eb4", "filename": "shortuuid/django_fields.py", "status": "modified", "additions": 2, "deletions": 1, "changes": 3, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/shortuuid%2Fdjango_fields.py", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/shortuuid%2Fdjango_fields.py", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/shortuuid%2Fdjango_fields.py?ref=7d94b71a32ac309e505362be1dc7dbd1bd6e5556", "patch": "@@ -14,6 +14,7 @@ class ShortUUIDField(models.CharField):\n     def __init__(self, *args: Any, **kwargs: Any) -> None:\n         self.length: int = kwargs.pop(\"length\", 22)  # type: ignore\n         self.prefix: str = kwargs.pop(\"prefix\", \"\")  # type: ignore\n+        self.dont_sort_alphabet: bool = kwargs.pop(\"dont_sort_alphabet\", False)  # type: ignore\n \n         if \"max_length\" not in kwargs:\n             # If `max_length` was not specified, set it here.\n@@ -26,7 +27,7 @@ def __init__(self, *args: Any, **kwargs: Any) -> None:\n \n     def _generate_uuid(self) -> str:\n         \"\"\"Generate a short random string.\"\"\"\n-        return self.prefix + ShortUUID(alphabet=self.alphabet).random(\n+        return self.prefix + ShortUUID(alphabet=self.alphabet, dont_sort_alphabet=self.dont_sort_alphabet).random(\n             length=self.length\n         )\n "}, {"sha": "7de31cae94d6d4b3c0586c967cd32bb7423c327f", "filename": "shortuuid/main.py", "status": "modified", "additions": 4, "deletions": 4, "changes": 8, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/shortuuid%2Fmain.py", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/shortuuid%2Fmain.py", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/shortuuid%2Fmain.py?ref=7d94b71a32ac309e505362be1dc7dbd1bd6e5556", "patch": "@@ -40,11 +40,11 @@ def string_to_int(string: str, alphabet: List[str]) -> int:\n \n \n class ShortUUID(object):\n-    def __init__(self, alphabet: Optional[str] = None) -> None:\n+    def __init__(self, alphabet: Optional[str] = None, dont_sort_alphabet: Optional[bool] = False) -> None:\n         if alphabet is None:\n             alphabet = \"23456789ABCDEFGHJKLMNPQRSTUVWXYZ\" \"abcdefghijkmnopqrstuvwxyz\"\n \n-        self.set_alphabet(alphabet)\n+        self.set_alphabet(alphabet, dont_sort_alphabet=dont_sort_alphabet)\n \n     @property\n     def _length(self) -> int:\n@@ -110,11 +110,11 @@ def get_alphabet(self) -> str:\n         \"\"\"Return the current alphabet used for new UUIDs.\"\"\"\n         return \"\".join(self._alphabet)\n \n-    def set_alphabet(self, alphabet: str) -> None:\n+    def set_alphabet(self, alphabet: str, dont_sort_alphabet: bool=False) -> None:\n         \"\"\"Set the alphabet to be used for new UUIDs.\"\"\"\n         # Turn the alphabet into a set and sort it to prevent duplicates\n         # and ensure reproducibility.\n-        new_alphabet = list(sorted(set(alphabet)))\n+        new_alphabet = list(dict.fromkeys(alphabet)) if dont_sort_alphabet else list(sorted(set(alphabet)))\n         if len(new_alphabet) > 1:\n             self._alphabet = new_alphabet\n             self._alpha_len = len(self._alphabet)"}, {"sha": "127908d3b92dd86cadad01b54c3b73283e0ab34d", "filename": "shortuuid/test_shortuuid.py", "status": "modified", "additions": 23, "deletions": 0, "changes": 23, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/shortuuid%2Ftest_shortuuid.py", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/7d94b71a32ac309e505362be1dc7dbd1bd6e5556/shortuuid%2Ftest_shortuuid.py", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/shortuuid%2Ftest_shortuuid.py?ref=7d94b71a32ac309e505362be1dc7dbd1bd6e5556", "patch": "@@ -115,6 +115,29 @@ def test_alphabet(self):\n         self.assertRaises(ValueError, su1.set_alphabet, \"1\")\n         self.assertRaises(ValueError, su1.set_alphabet, \"1111111\")\n \n+    def test_unsorted_alphabet(self):\n+        alphabet = \"123456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ\"\n+\n+        su1 = ShortUUID(alphabet, dont_sort_alphabet=True)\n+        su2 = ShortUUID()\n+\n+        self.assertEqual(alphabet, su1.get_alphabet())\n+\n+        su2.set_alphabet(alphabet, dont_sort_alphabet=True)\n+        self.assertEqual(alphabet, su2.get_alphabet())\n+\n+        su2.set_alphabet(alphabet + \"123abc\", dont_sort_alphabet=True)\n+        self.assertEqual(alphabet, su2.get_alphabet())\n+\n+        u = uuid4()\n+        self.assertEqual(u, su1.decode(su1.encode(u)))\n+\n+        u = su1.uuid()\n+        self.assertEqual(u, su1.encode(su1.decode(u)))\n+\n+        self.assertRaises(ValueError, su1.set_alphabet, \"1\")\n+        self.assertRaises(ValueError, su1.set_alphabet, \"1111111\")\n+\n     def test_encoded_length(self):\n         su1 = ShortUUID()\n         self.assertEqual(su1.encoded_length(), 22)"}]}