l Garcia Moreno", "email": "daniel.garcia@suse.com", "date": "2025-06-05T05:52:48Z"}, "message": "test: Add new test to check netrc auth leak\n\nThis patch adds a new test that reproduces the security issue reported\nhere:\nhttps://seclists.org/oss-sec/2025/q2/204\n\nDoing a request to a malicious url with a prefix like \"domain.com:@\"\nwill use the \"domain.com\" netrc credentials in the request to other\ndomain.", "tree": {"sha": "a75eb40146d0cffe0581f2f18451cf8348f35a3e", "url": "https://api.github.com/repos/psf/requests/git/trees/a75eb40146d0cffe0581f2f18451cf8348f35a3e"}, "url": "https://api.github.com/repos/psf/requests/git/commits/11e5adc9da430025b9a28527467b5fa5b4abb578", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/psf/requests/commits/11e5adc9da430025b9a28527467b5fa5b4abb578", "html_url": "https://github.com/psf/requests/commit/11e5adc9da430025b9a28527467b5fa5b4abb578", "comments_url": "https://api.github.com/repos/psf/requests/commits/11e5adc9da430025b9a28527467b5fa5b4abb578/comments", "author": {"login": "danigm", "id": 50350, "node_id": "MDQ6VXNlcjUwMzUw", "avatar_url": "https://avatars.githubusercontent.com/u/50350?v=4", "gravatar_id": "", "url": "https://api.github.com/users/danigm", "html_url": "https://github.com/danigm", "followers_url": "https://api.github.com/users/danigm/followers", "following_url": "https://api.github.com/users/danigm/following{/other_user}", "gists_url": "https://api.github.com/users/danigm/gists{/gist_id}", "starred_url": "https://api.github.com/users/danigm/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/danigm/subscriptions", "organizations_url": "https://api.github.com/users/danigm/orgs", "repos_url": "https://api.github.com/users/danigm/repos", "events_url": "https://api.github.com/users/danigm/events{/privacy}", "received_events_url": "https://api.github.com/users/danigm/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "danigm", "id": 50350, "node_id": "MDQ6VXNlcjUwMzUw", "avatar_url": "https://avatars.githubusercontent.com/u/50350?v=4", "gravatar_id": "", "url": "https://api.github.com/users/danigm", "html_url": "https://github.com/danigm", "followers_url": "https://api.github.com/users/danigm/followers", "following_url": "https://api.github.com/users/danigm/following{/other_user}", "gists_url": "https://api.github.com/users/danigm/gists{/gist_id}", "starred_url": "https://api.github.com/users/danigm/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/danigm/subscriptions", "organizations_url": "https://api.github.com/users/danigm/orgs", "repos_url": "https://api.github.com/users/danigm/repos", "events_url": "https://api.github.com/users/danigm/events{/privacy}", "received_events_url": "https://api.github.com/users/danigm/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "96ba401c1296ab1dda74a2365ef36d88f7d144ef", "url": "https://api.github.com/repos/psf/requests/commits/96ba401c1296ab1dda74a2365ef36d88f7d144ef", "html_url": "https://github.com/psf/requests/commit/96ba401c1296ab1dda74a2365ef36d88f7d144ef"}]}], "files": [{"sha": "75d2deff2e0eb9dbc7add566ba6d050f8e95e29f", "filename": "tests/test_requests.py", "status": "modified", "additions": 31, "deletions": 0, "changes": 31, "blob_url": "https://github.com/psf/requests/blob/11e5adc9da430025b9a28527467b5fa5b4abb578/tests%2Ftest_requests.py", "raw_url": "https://github.com/psf/requests/raw/11e5adc9da430025b9a28527467b5fa5b4abb578/tests%2Ftest_requests.py", "contents_url": "https://api.github.com/repos/psf/requests/contents/tests%2Ftest_requests.py?ref=11e5adc9da430025b9a28527467b5fa5b4abb578", "patch": "@@ -7,6 +7,7 @@\n import os\n import pickle\n import re\n+import tempfile\n import threading\n import warnings\n from unittest import mock\n@@ -704,6 +705,36 @@ def get_netrc_auth_mock(url):\n         finally:\n             requests.sessions.get_netrc_auth = old_auth\n \n+    def test_basicauth_with_netrc_leak(self, httpbin):\n+        url1 = httpbin(\"basic-auth\", \"user\", \"pass\")\n+        url = url1[len(\"http://\") :]\n+        domain = url.split(\":\")[0]\n+        url = f\"http://example.com:@{url}\"\n+\n+        netrc_file = \"\"\n+        with tempfile.NamedTemporaryFile(mode=\"w\", delete=False) as fp:\n+            fp.write(\"machine example.com\\n\")\n+            fp.write(\"login wronguser\\n\")\n+            fp.write(\"password wrongpass\\n\")\n+            fp.write(f\"machine {domain}\\n\")\n+            fp.write(\"login user\\n\")\n+            fp.write(\"password pass\\n\")\n+            fp.close()\n+            netrc_file = fp.name\n+\n+        old_netrc = os.environ.get(\"NETRC\", \"\")\n+        os.environ[\"NETRC\"] = netrc_file\n+\n+        try:\n+            # Should use netrc\n+            # Make sure that we don't use the example.com credentails\n+            # for the request\n+            r = requests.get(url)\n+            assert r.status_code == 200\n+        finally:\n+            os.environ[\"NETRC\"] = old_netrc\n+            os.unlink(netrc_file)\n+\n     def test_DIGEST_HTTP_200_OK_GET(self, httpbin):\n         for authtype in self.digest_auth_algo:\n             auth = HTTPDigestAuth(\"user\", \"pass\")"}]}