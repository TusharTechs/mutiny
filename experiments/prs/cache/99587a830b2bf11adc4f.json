github.com/netromdk/vermin\n+  rev: v1.8.0\n+  hooks:\n+  - id: vermin\n+    name: Verify Python 3.6+ compatibility\n+    args: ['-t=3.6-', '--violations']\n - repo: local\n   hooks:\n   - id: gitchangelog\n@@ -26,4 +32,4 @@ repos:\n     pass_filenames: false\n     name: Generate changelog\n     entry: bash -c \"gitchangelog > CHANGELOG.md\"\n-    stages: [commit]\n+    stages: [pre-commit]"}, {"sha": "b2340960d3d533d80227584b5a8f5c613054fe96", "filename": "CHANGELOG.md", "status": "modified", "additions": 11, "deletions": 0, "changes": 11, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/c27a65b7f65c261f4f420b48a1026e8b1d50c7e2/CHANGELOG.md", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/c27a65b7f65c261f4f420b48a1026e8b1d50c7e2/CHANGELOG.md", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/CHANGELOG.md?ref=c27a65b7f65c261f4f420b48a1026e8b1d50c7e2", "patch": "@@ -3,6 +3,17 @@\n \n ## Unreleased\n \n+### Features\n+\n+* Allow compatibility with other ShortUUID libraries (#104) (#107) [Thiago Marinho]\n+\n+### Fixes\n+\n+* Don't install COPYING at top level of wheel (#105) [Colin Watson]\n+\n+\n+## v1.0.13 (2024-03-11)\n+\n ### Fixes\n \n * Improve randomness (#101) (#103) [hhartzer]"}, {"sha": "24d5b7f62835b7a11125388a8320acc13a9aa79e", "filename": "shortuuid/django_fields.py", "status": "modified", "additions": 3, "deletions": 3, "changes": 6, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/c27a65b7f65c261f4f420b48a1026e8b1d50c7e2/shortuuid%2Fdjango_fields.py", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/c27a65b7f65c261f4f420b48a1026e8b1d50c7e2/shortuuid%2Fdjango_fields.py", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/shortuuid%2Fdjango_fields.py?ref=c27a65b7f65c261f4f420b48a1026e8b1d50c7e2", "patch": "@@ -27,9 +27,9 @@ def __init__(self, *args: Any, **kwargs: Any) -> None:\n \n     def _generate_uuid(self) -> str:\n         \"\"\"Generate a short random string.\"\"\"\n-        return self.prefix + ShortUUID(alphabet=self.alphabet, dont_sort_alphabet=self.dont_sort_alphabet).random(\n-            length=self.length\n-        )\n+        return self.prefix + ShortUUID(\n+            alphabet=self.alphabet, dont_sort_alphabet=self.dont_sort_alphabet\n+        ).random(length=self.length)\n \n     def deconstruct(self) -> Tuple[str, str, Tuple, Dict[str, Any]]:\n         name, path, args, kwargs = super().deconstruct()"}, {"sha": "1c34eb66af48d7418d250408eefdbead73bdf056", "filename": "shortuuid/main.py", "status": "modified", "additions": 9, "deletions": 3, "changes": 12, "blob_url": "https://github.com/skorokithakis/shortuuid/blob/c27a65b7f65c261f4f420b48a1026e8b1d50c7e2/shortuuid%2Fmain.py", "raw_url": "https://github.com/skorokithakis/shortuuid/raw/c27a65b7f65c261f4f420b48a1026e8b1d50c7e2/shortuuid%2Fmain.py", "contents_url": "https://api.github.com/repos/skorokithakis/shortuuid/contents/shortuuid%2Fmain.py?ref=c27a65b7f65c261f4f420b48a1026e8b1d50c7e2", "patch": "@@ -40,7 +40,9 @@ def string_to_int(string: str, alphabet: List[str]) -> int:\n \n \n class ShortUUID(object):\n-    def __init__(self, alphabet: Optional[str] = None, dont_sort_alphabet: Optional[bool] = False) -> None:\n+    def __init__(\n+        self, alphabet: Optional[str] = None, dont_sort_alphabet: bool = False\n+    ) -> None:\n         if alphabet is None:\n             alphabet = \"23456789ABCDEFGHJKLMNPQRSTUVWXYZ\" \"abcdefghijkmnopqrstuvwxyz\"\n \n@@ -110,11 +112,15 @@ def get_alphabet(self) -> str:\n         \"\"\"Return the current alphabet used for new UUIDs.\"\"\"\n         return \"\".join(self._alphabet)\n \n-    def set_alphabet(self, alphabet: str, dont_sort_alphabet: bool=False) -> None:\n+    def set_alphabet(self, alphabet: str, dont_sort_alphabet: bool = False) -> None:\n         \"\"\"Set the alphabet to be used for new UUIDs.\"\"\"\n         # Turn the alphabet into a set and sort it to prevent duplicates\n         # and ensure reproducibility.\n-        new_alphabet = list(dict.fromkeys(alphabet)) if dont_sort_alphabet else list(sorted(set(alphabet)))\n+        new_alphabet = (\n+            list(dict.fromkeys(alphabet))\n+            if dont_sort_alphabet\n+            else list(sorted(set(alphabet)))\n+        )\n         if len(new_alphabet) > 1:\n             self._alphabet = new_alphabet\n             self._alpha_len = len(self._alphabet)"}]}