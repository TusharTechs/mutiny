fac11549d103bc74aefbf851940c8ce3a398fa86/src%2Fcachetools%2F__init__.py", "contents_url": "https://api.github.com/repos/tkem/cachetools/contents/src%2Fcachetools%2F__init__.py?ref=fac11549d103bc74aefbf851940c8ce3a398fa86", "patch": "@@ -75,6 +75,8 @@ def __getitem__(self, key):\n     def __setitem__(self, key, value):\n         maxsize = self.__maxsize\n         size = self.getsizeof(value)\n+        if size < 0:\n+            raise ValueError(\"value size must be non-negative\")\n         if size > maxsize:\n             raise ValueError(\"value too large\")\n         if key not in self.__data or self.__size[key] < size:"}, {"sha": "a84f19e89da95e937f959c61d3e97cc2cebeb369", "filename": "tests/__init__.py", "status": "modified", "additions": 9, "deletions": 0, "changes": 9, "blob_url": "https://github.com/tkem/cachetools/blob/fac11549d103bc74aefbf851940c8ce3a398fa86/tests%2F__init__.py", "raw_url": "https://github.com/tkem/cachetools/raw/fac11549d103bc74aefbf851940c8ce3a398fa86/tests%2F__init__.py", "contents_url": "https://api.github.com/repos/tkem/cachetools/contents/tests%2F__init__.py?ref=fac11549d103bc74aefbf851940c8ce3a398fa86", "patch": "@@ -284,6 +284,15 @@ def _test_getsizeof(self, cache):\n     def test_getsizeof_param(self):\n         self._test_getsizeof(self.Cache(maxsize=3, getsizeof=lambda x: x))\n \n+    def test_getsizeof_negative(self):\n+        cache = self.Cache(maxsize=3, getsizeof=lambda x: -1)\n+\n+        with self.assertRaises(ValueError):\n+            cache[1] = 1\n+\n+        self.assertEqual(0, len(cache))\n+        self.assertEqual(0, cache.currsize)\n+\n     def test_getsizeof_subclass(self):\n         class Cache(self.Cache):\n             @staticmethod"}]}