bcaf", "filename": "docs/usage/increase-parts-of-a-version_prereleases.rst", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/python-semver/python-semver/blob/3d4421326bcd2511c9773d4ebbefe4a9a5c5f521/docs%2Fusage%2Fincrease-parts-of-a-version_prereleases.rst", "raw_url": "https://github.com/python-semver/python-semver/raw/3d4421326bcd2511c9773d4ebbefe4a9a5c5f521/docs%2Fusage%2Fincrease-parts-of-a-version_prereleases.rst", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/docs%2Fusage%2Fincrease-parts-of-a-version_prereleases.rst?ref=3d4421326bcd2511c9773d4ebbefe4a9a5c5f521", "patch": "@@ -15,7 +15,7 @@ would perhaps a better fit.\n \n     >>> v = Version.parse(\"3.4.5-pre.2+build.4\")\n     >>> str(v.next_version(part=\"prerelease\"))\n-    '3.4.5-pre.3'\n+    '3.4.5-rc.1'\n     >>> str(Version.parse(\"3.4.5-pre.2+build.4\").next_version(part=\"patch\"))\n     '3.4.5'\n     >>> str(Version.parse(\"3.4.5+build.4\").next_version(part=\"patch\"))"}, {"sha": "8c6eca8067823c66ebe2dc8f98992602ce08011c", "filename": "src/semver/version.py", "status": "modified", "additions": 4, "deletions": 0, "changes": 4, "blob_url": "https://github.com/python-semver/python-semver/blob/3d4421326bcd2511c9773d4ebbefe4a9a5c5f521/src%2Fsemver%2Fversion.py", "raw_url": "https://github.com/python-semver/python-semver/raw/3d4421326bcd2511c9773d4ebbefe4a9a5c5f521/src%2Fsemver%2Fversion.py", "contents_url": "https://api.github.com/repos/python-semver/python-semver/contents/src%2Fsemver%2Fversion.py?ref=3d4421326bcd2511c9773d4ebbefe4a9a5c5f521", "patch": "@@ -482,6 +482,10 @@ def next_version(self, part: str, prerelease_token: str = \"rc\") -> \"Version\":\n         if part in cls.NAMES[:3]:\n             return getattr(version, \"bump_\" + part)()\n         else:\n+            if version.prerelease is not None and prerelease_token:\n+                current_token = version.prerelease.split(\".\")[0]\n+                if current_token != prerelease_token:\n+                    return version.replace(prerelease=f\"{prerelease_token}.1\", build=None)\n             return version.bump_prerelease(prerelease_token, bump_when_empty=True)\n \n     @_comparator"}]}