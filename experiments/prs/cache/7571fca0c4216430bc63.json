----------------------+\n | Wrapping               | `always_iterable <https://more-itertools.readthedocs.io/en/stable/api.html#more_itertools.always_iterable>`_,                                                               |\n |                        | `always_reversible <https://more-itertools.readthedocs.io/en/stable/api.html#more_itertools.always_reversible>`_,                                                           |"}, {"sha": "7b40a8ec1283d4da97203fc9ebb9f36d5f6edeb4", "filename": "docs/api.rst", "status": "modified", "additions": 1, "deletions": 0, "changes": 1, "blob_url": "https://github.com/more-itertools/more-itertools/blob/37f99c53a92b6254b671491b698ebdf6562ecb50/docs%2Fapi.rst", "raw_url": "https://github.com/more-itertools/more-itertools/raw/37f99c53a92b6254b671491b698ebdf6562ecb50/docs%2Fapi.rst", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/docs%2Fapi.rst?ref=37f99c53a92b6254b671491b698ebdf6562ecb50", "patch": "@@ -264,6 +264,7 @@ These tools yield combinatorial arrangements of items from iterables.\n .. autofunction:: nth_product\n .. autofunction:: nth_permutation\n .. autofunction:: nth_combination\n+.. autofunction:: random_ordered_range\n \n \n Wrapping"}, {"sha": "fb0b678b4ae57c0db94023b9cc48fdf89d54b072", "filename": "more_itertools/more.py", "status": "modified", "additions": 44, "deletions": 0, "changes": 44, "blob_url": "https://github.com/more-itertools/more-itertools/blob/37f99c53a92b6254b671491b698ebdf6562ecb50/more_itertools%2Fmore.py", "raw_url": "https://github.com/more-itertools/more-itertools/raw/37f99c53a92b6254b671491b698ebdf6562ecb50/more_itertools%2Fmore.py", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/more_itertools%2Fmore.py?ref=37f99c53a92b6254b671491b698ebdf6562ecb50", "patch": "@@ -140,6 +140,7 @@\n     'powerset_of_sets',\n     'product_index',\n     'raise_',\n+    'random_ordered_range',\n     'repeat_each',\n     'repeat_last',\n     'replace',\n@@ -5596,3 +5597,46 @@ def subfactorial(n):\n         sf = sf * i + adj\n         adj = -adj\n     return sf\n+\n+\n+def _full_period_lcg(n):\n+    \"Returns values from range(n) in randomly shuffled order.\"\n+\n+    # The algorithm is a fluxed, full period linear congruential generator.\n+    # Size *m* is a power of two.  The *mask* speeds-up modulo calculations.\n+    # The multiplier *a* and addend *c* are Hull-Dobell constants.  See:\n+    # https://jackgiffin.com/main/pdfs/Random-Number-Generators-T-E-Hull-and-A-R-Dobell.pdf\n+    # The value *x* is a random starting point.\n+    # The *flux* bitfield breaks-up patterns in the LCG.\n+\n+    m = 1 << n.bit_length()\n+    mask = m - 1\n+    a = randrange(5, m, 4) if m > 4 else 1\n+    c = randrange(1, m, 2) if m > 1 else 1\n+    x = randrange(m)\n+    flux = randrange(m)\n+\n+    for _ in repeat(None, m):\n+        index = x ^ flux\n+        if index < n:\n+            yield index\n+        x = (a * x + c) & mask\n+\n+\n+def _random_ordered_indices(n):\n+    \"Shuffle batches to mitigate the small state space of the LCG.\"\n+\n+    # Batched variation of Knuth's Algorithm M in \u00a73.2.2 of TAOCP.\n+    batch_size = 1024\n+    iterable = range(n) if n <= batch_size else _full_period_lcg(n)\n+    for batch in map(list, batched(iterable, batch_size)):\n+        shuffle(batch)\n+        yield from batch\n+\n+\n+def random_ordered_range(*args):\n+    \"Return :func:`range` values in randomly shuffled order.\"\n+    range_object = range(*args)\n+    n = len(range_object)\n+    for index in _random_ordered_indices(n):\n+        yield range_object[index]"}, {"sha": "927cb2134e2fd1efbc000d480a51016ffb552a6f", "filename": "more_itertools/more.pyi", "status": "modified", "additions": 4, "deletions": 0, "changes": 4, "blob_url": "https://github.com/more-itertools/more-itertools/blob/37f99c53a92b6254b671491b698ebdf6562ecb50/more_itertools%2Fmore.pyi", "raw_url": "https://github.com/more-itertools/more-itertools/raw/37f99c53a92b6254b671491b698ebdf6562ecb50/more_itertools%2Fmore.pyi", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/more_itertools%2Fmore.pyi?ref=37f99c53a92b6254b671491b698ebdf6562ecb50", "patch": "@@ -113,6 +113,7 @@ __all__ = [\n     'powerset_of_sets',\n     'product_index',\n     'raise_',\n+    'random_ordered_range',\n     'repeat_each',\n     'repeat_last',\n     'replace',\n@@ -1018,3 +1019,6 @@ def concurrent_tee(\n def synchronized(\n     func: Callable[..., Iterator[_T]],\n ) -> Callable[..., Iterator[_T]]: ...\n+def random_ordered_range(\n+    *args: int,\n+) -> Iterator[int]: ..."}, {"sha": "fa4d584154796ae96d77d0824cf52399a5b5dbc4", "filename": "tests/test_more.py", "status": "modified", "additions": 31, "deletions": 0, "changes": 31, "blob_url": "https://github.com/more-itertools/more-itertools/blob/37f99c53a92b6254b671491b698ebdf6562ecb50/tests%2Ftest_more.py", "raw_url": "https://github.com/more-itertools/more-itertools/raw/37f99c53a92b6254b671491b698ebdf6562ecb50/tests%2Ftest_more.py", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/tests%2Ftest_more.py?ref=37f99c53a92b6254b671491b698ebdf6562ecb50", "patch": "@@ -27,6 +27,7 @@\n     product,\n     repeat,\n )\n+from math import factorial\n from operator import add, mul, itemgetter, not_\n from pickle import loads, dumps\n from random import Random, choices, random, randrange, seed\n@@ -7177,3 +7178,33 @@ def test_error_cases(self):\n             mi.subfactorial('5')  # string input\n         with self.assertRaises(ValueError):\n             mi.subfactorial(-1)  # negative input\n+\n+\n+class TestRandomOrderedRange(TestCase):\n+    test_inputs = [\n+        (-1,),\n+        (0,),\n+        (1,),\n+        (2,),\n+        (3,),\n+        (4,),\n+        (10,),\n+        (50,),\n+        (10_000,),\n+        (100, 200),\n+        (1000, 2000, 10),\n+        (2000, 1000, -10),\n+    ]\n+\n+    def test_vs_ordered_baseline(self):\n+        # Verify that the randomized values match the ordered values.\n+        for args in self.test_inputs:\n+            with self.subTest(args=args):\n+                randomized = sorted(mi.random_ordered_range(*args))\n+                ordered = sorted(range(*args))\n+                self.assertEqual(randomized, ordered)\n+\n+    def test_lcg_mitigation(self):\n+        # Without mitigation the LCG doesn't produce many distinct permutations\n+        perms = set(tuple(mi.random_ordered_range(6)) for _ in range(10**5))\n+        self.assertEqual(len(perms), factorial(6))"}]}