user_view_type": "public", "site_admin": false}, "committer": {"login": "tkem", "id": 2833077, "node_id": "MDQ6VXNlcjI4MzMwNzc=", "avatar_url": "https://avatars.githubusercontent.com/u/2833077?v=4", "gravatar_id": "", "url": "https://api.github.com/users/tkem", "html_url": "https://github.com/tkem", "followers_url": "https://api.github.com/users/tkem/followers", "following_url": "https://api.github.com/users/tkem/following{/other_user}", "gists_url": "https://api.github.com/users/tkem/gists{/gist_id}", "starred_url": "https://api.github.com/users/tkem/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/tkem/subscriptions", "organizations_url": "https://api.github.com/users/tkem/orgs", "repos_url": "https://api.github.com/users/tkem/repos", "events_url": "https://api.github.com/users/tkem/events{/privacy}", "received_events_url": "https://api.github.com/users/tkem/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "ccaa8c8c882b7cb76904ea5ae21aae33cca0c2c1", "url": "https://api.github.com/repos/tkem/cachetools/commits/ccaa8c8c882b7cb76904ea5ae21aae33cca0c2c1", "html_url": "https://github.com/tkem/cachetools/commit/ccaa8c8c882b7cb76904ea5ae21aae33cca0c2c1"}]}, "status": "diverged", "ahead_by": 1, "behind_by": 1, "total_commits": 1, "commits": [{"sha": "35b04d750583e839b9ac4b4342248827a12bff9b", "node_id": "C_kwDOARLDB9oAKDM1YjA0ZDc1MDU4M2U4MzliOWFjNGI0MzQyMjQ4ODI3YTEyYmZmOWI", "commit": {"author": {"name": "Teddy Tennant", "email": "teddytennant@icloud.com", "date": "2026-08-08T21:26:13Z"}, "committer": {"name": "Teddy Tennant", "email": "teddytennant@icloud.com", "date": "2026-08-08T21:26:13Z"}, "message": "Reject negative maxsize in Cache.__init__\n\nA negative maxsize produces a cache that can never hold anything, but\nthe constructor accepted it silently. The failure only surfaced on the\nfirst insert as `ValueError: value too large`, which points at the\nvalue rather than at the maxsize that was actually wrong, and under\n`@cached`/`@cachedmethod` it did not surface at all, since those catch\n`ValueError` and simply fall through to the wrapped function.\n\nValidate maxsize on construction instead, matching the existing\nnon-negative check on `getsizeof()` results in `Cache.__setitem__()`.\n\n`maxsize=0` is still accepted: it is a documented no-space cache used\nby the decorators' `test_nospace` cases and by `test_pickle_maxsize`.\n`math.inf` is still accepted, as used by `cachetools.func._UnboundTTLCache`.", "tree": {"sha": "f909bcedeea7e6ada82474aca8a32b8f0e41513a", "url": "https://api.github.com/repos/tkem/cachetools/git/trees/f909bcedeea7e6ada82474aca8a32b8f0e41513a"}, "url": "https://api.github.com/repos/tkem/cachetools/git/commits/35b04d750583e839b9ac4b4342248827a12bff9b", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/tkem/cachetools/commits/35b04d750583e839b9ac4b4342248827a12bff9b", "html_url": "https://github.com/tkem/cachetools/commit/35b04d750583e839b9ac4b4342248827a12bff9b", "comments_url": "https://api.github.com/repos/tkem/cachetools/commits/35b04d750583e839b9ac4b4342248827a12bff9b/comments", "author": {"login": "teddytennant", "id": 192647641, "node_id": "U_kgDOC3uR2Q", "avatar_url": "https://avatars.githubusercontent.com/u/192647641?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teddytennant", "html_url": "https://github.com/teddytennant", "followers_url": "https://api.github.com/users/teddytennant/followers", "following_url": "https://api.github.com/users/teddytennant/following{/other_user}", "gists_url": "https://api.github.com/users/teddytennant/gists{/gist_id}", "starred_url": "https://api.github.com/users/teddytennant/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teddytennant/subscriptions", "organizations_url": "https://api.github.com/users/teddytennant/orgs", "repos_url": "https://api.github.com/users/teddytennant/repos", "events_url": "https://api.github.com/users/teddytennant/events{/privacy}", "received_events_url": "https://api.github.com/users/teddytennant/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "teddytennant", "id": 192647641, "node_id": "U_kgDOC3uR2Q", "avatar_url": "https://avatars.githubusercontent.com/u/192647641?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teddytennant", "html_url": "https://github.com/teddytennant", "followers_url": "https://api.github.com/users/teddytennant/followers", "following_url": "https://api.github.com/users/teddytennant/following{/other_user}", "gists_url": "https://api.github.com/users/teddytennant/gists{/gist_id}", "starred_url": "https://api.github.com/users/teddytennant/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teddytennant/subscriptions", "organizations_url": "https://api.github.com/users/teddytennant/orgs", "repos_url": "https://api.github.com/users/teddytennant/repos", "events_url": "https://api.github.com/users/teddytennant/events{/privacy}", "received_events_url": "https://api.github.com/users/teddytennant/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "01af8e5b7ce44432b357e26c7d67eb7fa055ae72", "url": "https://api.github.com/repos/tkem/cachetools/commits/01af8e5b7ce44432b357e26c7d67eb7fa055ae72", "html_url": "https://github.com/tkem/cachetools/commit/01af8e5b7ce44432b357e26c7d67eb7fa055ae72"}]}], "files": [{"sha": "c35488ec34b7c6e128dfb5e9d835788638bcbb1c", "filename": "src/cachetools/__init__.py", "status": "modified", "additions": 2, "deletions": 0, "changes": 2, "blob_url": "https://github.com/tkem/cachetools/blob/35b04d750583e839b9ac4b4342248827a12bff9b/src%2Fcachetools%2F__init__.py", "raw_url": "https://github.com/tkem/cachetools/raw/35b04d750583e839b9ac4b4342248827a12bff9b/src%2Fcachetools%2F__init__.py", "contents_url": "https://api.github.com/repos/tkem/cachetools/contents/src%2Fcachetools%2F__init__.py?ref=35b04d750583e839b9ac4b4342248827a12bff9b", "patch": "@@ -50,6 +50,8 @@ class Cache(collections.abc.MutableMapping):\n     __size = _DefaultSize()\n \n     def __init__(self, maxsize, getsizeof=None):\n+        if maxsize < 0:\n+            raise ValueError(\"maxsize must be non-negative\")\n         if getsizeof:\n             self.getsizeof = getsizeof\n         if self.getsizeof is not Cache.getsizeof:"}, {"sha": "2adcc630e1f32a451d6e5b351e0cef6aea12bb1d", "filename": "tests/__init__.py", "status": "modified", "additions": 24, "deletions": 0, "changes": 24, "blob_url": "https://github.com/tkem/cachetools/blob/35b04d750583e839b9ac4b4342248827a12bff9b/tests%2F__init__.py", "raw_url": "https://github.com/tkem/cachetools/raw/35b04d750583e839b9ac4b4342248827a12bff9b/tests%2F__init__.py", "contents_url": "https://api.github.com/repos/tkem/cachetools/contents/tests%2F__init__.py?ref=35b04d750583e839b9ac4b4342248827a12bff9b", "patch": "@@ -1,3 +1,4 @@\n+import math\n from collections.abc import Container, Iterable\n from typing import Any, Protocol\n \n@@ -41,6 +42,29 @@ def test_defaults(self):\n         self.assertEqual(1, cache.getsizeof(0))\n         self.assertTrue(repr(cache).startswith(cache.__class__.__name__))\n \n+    def test_maxsize_negative(self):\n+        with self.assertRaises(ValueError):\n+            self.Cache(maxsize=-1)\n+\n+        with self.assertRaises(ValueError):\n+            self.Cache(maxsize=-math.inf)\n+\n+    def test_maxsize_zero(self):\n+        cache = self.Cache(maxsize=0)\n+\n+        self.assertEqual(0, cache.maxsize)\n+        with self.assertRaises(ValueError):\n+            cache[1] = 1\n+        self.assertEqual(0, len(cache))\n+        self.assertEqual(0, cache.currsize)\n+\n+    def test_maxsize_infinite(self):\n+        cache = self.Cache(maxsize=math.inf)\n+\n+        cache.update((i, i) for i in range(100))\n+        self.assertEqual(100, len(cache))\n+        self.assertEqual(100, cache.currsize)\n+\n     def test_insert(self):\n         cache = self.Cache(maxsize=2)\n "}]}