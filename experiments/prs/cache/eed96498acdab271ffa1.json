m/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "30ada7dd597316a3ef967911477e0a1d9f55eefe", "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/30ada7dd597316a3ef967911477e0a1d9f55eefe", "html_url": "https://github.com/more-itertools/more-itertools/commit/30ada7dd597316a3ef967911477e0a1d9f55eefe"}, {"sha": "dc2664b4a7c66209485c9f5e359137bf4b365eb3", "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/dc2664b4a7c66209485c9f5e359137bf4b365eb3", "html_url": "https://github.com/more-itertools/more-itertools/commit/dc2664b4a7c66209485c9f5e359137bf4b365eb3"}]}, "status": "diverged", "ahead_by": 1, "behind_by": 2, "total_commits": 1, "commits": [{"sha": "7847d4324a581da8d0919734a8e50b2a6573b780", "node_id": "C_kwDOAD89ktoAKDc4NDdkNDMyNGE1ODFkYThkMDkxOTczNGE4ZTUwYjJhNjU3M2I3ODA", "commit": {"author": {"name": "Onkesh Bansal", "email": "onkesh2022@gmail.com", "date": "2026-09-03T15:22:05Z"}, "committer": {"name": "Onkesh Bansal", "email": "onkesh2022@gmail.com", "date": "2026-09-03T15:22:05Z"}, "message": "Don't mask TypeError raised while iterating in value_chain\n\nvalue_chain used `yield from value` inside a `try/except TypeError`\nguard. Because `yield from` consumes lazily, the guard stayed active\nfor the whole consumption rather than only classifying the argument,\nso a TypeError raised from inside the argument was swallowed and the\npartially-consumed object was emitted after the items it had already\nproduced:\n\n    >>> list(value_chain(map(len, ['ab', 'cde', 5])))\n    [2, 3, <map object at 0x...>]\n\nClassify the argument with iter() and consume it outside the guard.\nArguments that cannot be iterated at all are still emitted as-is.", "tree": {"sha": "2c29992b8e8cab9fa494d518a1e4c559ce2b9c95", "url": "https://api.github.com/repos/more-itertools/more-itertools/git/trees/2c29992b8e8cab9fa494d518a1e4c559ce2b9c95"}, "url": "https://api.github.com/repos/more-itertools/more-itertools/git/commits/7847d4324a581da8d0919734a8e50b2a6573b780", "comment_count": 0, "verification": {"verified": false, "reason": "no_user", "signature": "-----BEGIN PGP SIGNATURE-----\n\niJEEABYKADkWIQSPWdiw+j4ZaI722auWCqIPBMnq6wUCapmQnRsUgAAAAAAEAA5t\nYW51MiwyLjUrMS4xMiwwLDMACgkQlgqiDwTJ6us0ewEAoiwVYsGa4x+5g92oI8u1\nv9pwZXm3Hrscep5iddxoDE8A/1kjQQMuuThxE1LbLMGHcLMa1e5qQY7Z35iYyMth\njf0N\n=L1X6\n-----END PGP SIGNATURE-----", "payload": "tree 2c29992b8e8cab9fa494d518a1e4c559ce2b9c95\nparent bc8be1013ac90fe3c1df8aae646b02605d578818\nauthor Onkesh Bansal <onkesh2022@gmail.com> 1788448925 -0400\ncommitter Onkesh Bansal <onkesh2022@gmail.com> 1788448925 -0400\n\nDon't mask TypeError raised while iterating in value_chain\n\nvalue_chain used `yield from value` inside a `try/except TypeError`\nguard. Because `yield from` consumes lazily, the guard stayed active\nfor the whole consumption rather than only classifying the argument,\nso a TypeError raised from inside the argument was swallowed and the\npartially-consumed object was emitted after the items it had already\nproduced:\n\n    >>> list(value_chain(map(len, ['ab', 'cde', 5])))\n    [2, 3, <map object at 0x...>]\n\nClassify the argument with iter() and consume it outside the guard.\nArguments that cannot be iterated at all are still emitted as-is.\n", "verified_at": null}}, "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/7847d4324a581da8d0919734a8e50b2a6573b780", "html_url": "https://github.com/more-itertools/more-itertools/commit/7847d4324a581da8d0919734a8e50b2a6573b780", "comments_url": "https://api.github.com/repos/more-itertools/more-itertools/commits/7847d4324a581da8d0919734a8e50b2a6573b780/comments", "author": null, "committer": null, "parents": [{"sha": "bc8be1013ac90fe3c1df8aae646b02605d578818", "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/bc8be1013ac90fe3c1df8aae646b02605d578818", "html_url": "https://github.com/more-itertools/more-itertools/commit/bc8be1013ac90fe3c1df8aae646b02605d578818"}]}], "files": [{"sha": "eec094fbe0bb663ac26675ce6f3c0b66bac577f3", "filename": "more_itertools/more.py", "status": "modified", "additions": 3, "deletions": 1, "changes": 4, "blob_url": "https://github.com/more-itertools/more-itertools/blob/7847d4324a581da8d0919734a8e50b2a6573b780/more_itertools%2Fmore.py", "raw_url": "https://github.com/more-itertools/more-itertools/raw/7847d4324a581da8d0919734a8e50b2a6573b780/more_itertools%2Fmore.py", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/more_itertools%2Fmore.py?ref=7847d4324a581da8d0919734a8e50b2a6573b780", "patch": "@@ -4414,9 +4414,11 @@ def value_chain(*args):\n             yield value\n             continue\n         try:\n-            yield from value\n+            it = iter(value)\n         except TypeError:\n             yield value\n+        else:\n+            yield from it\n \n \n def product_index(element, *iterables, repeat=1):"}, {"sha": "9ec108db776b0ce37e7758639ec61b3b9a6b729b", "filename": "tests/test_more.py", "status": "modified", "additions": 22, "deletions": 0, "changes": 22, "blob_url": "https://github.com/more-itertools/more-itertools/blob/7847d4324a581da8d0919734a8e50b2a6573b780/tests%2Ftest_more.py", "raw_url": "https://github.com/more-itertools/more-itertools/raw/7847d4324a581da8d0919734a8e50b2a6573b780/tests%2Ftest_more.py", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/tests%2Ftest_more.py?ref=7847d4324a581da8d0919734a8e50b2a6573b780", "patch": "@@ -5074,6 +5074,28 @@ def test_complex(self):\n         expected = [1, (2, (3,)), 'foo', ['bar', ['baz']], 'tic', 'key', obj]\n         self.assertEqual(actual, expected)\n \n+    def test_type_error_while_iterating(self):\n+        # A TypeError raised while consuming an argument means the argument\n+        # is broken, not that it is a scalar - it should propagate.\n+        def gen():\n+            yield 1\n+            yield 2\n+            raise TypeError('failure inside the iterable')\n+\n+        it = mi.value_chain(gen(), 3)\n+        self.assertEqual([next(it), next(it)], [1, 2])\n+        with self.assertRaises(TypeError):\n+            next(it)\n+\n+    def test_type_error_from_iter(self):\n+        # An object that cannot be iterated at all is still emitted as-is.\n+        class NotIterable:\n+            def __iter__(self):\n+                raise TypeError('not iterable')\n+\n+        obj = NotIterable()\n+        self.assertEqual(list(mi.value_chain(1, obj, [2, 3])), [1, obj, 2, 3])\n+\n \n class ProductIndexTests(TestCase):\n     def test_basic(self):"}]}