ved_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "tkem", "id": 2833077, "node_id": "MDQ6VXNlcjI4MzMwNzc=", "avatar_url": "https://avatars.githubusercontent.com/u/2833077?v=4", "gravatar_id": "", "url": "https://api.github.com/users/tkem", "html_url": "https://github.com/tkem", "followers_url": "https://api.github.com/users/tkem/followers", "following_url": "https://api.github.com/users/tkem/following{/other_user}", "gists_url": "https://api.github.com/users/tkem/gists{/gist_id}", "starred_url": "https://api.github.com/users/tkem/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/tkem/subscriptions", "organizations_url": "https://api.github.com/users/tkem/orgs", "repos_url": "https://api.github.com/users/tkem/repos", "events_url": "https://api.github.com/users/tkem/events{/privacy}", "received_events_url": "https://api.github.com/users/tkem/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "e2250be46b9d8ed76b82c1c18a4465c0b1167b8a", "url": "https://api.github.com/repos/tkem/cachetools/commits/e2250be46b9d8ed76b82c1c18a4465c0b1167b8a", "html_url": "https://github.com/tkem/cachetools/commit/e2250be46b9d8ed76b82c1c18a4465c0b1167b8a"}]}, "status": "ahead", "ahead_by": 2, "behind_by": 0, "total_commits": 2, "commits": [{"sha": "4dd976de71a0cb488f03719c2788b438e2f5ce1c", "node_id": "C_kwDOARLDB9oAKDRkZDk3NmRlNzFhMGNiNDg4ZjAzNzE5YzI3ODhiNDM4ZTJmNWNlMWM", "commit": {"author": {"name": "Sanjay Santhanam", "email": "51058514+Sanjays2402@users.noreply.github.com", "date": "2026-07-25T00:21:38Z"}, "committer": {"name": "Sanjay Santhanam", "email": "51058514+Sanjays2402@users.noreply.github.com", "date": "2026-07-25T00:21:38Z"}, "message": "Fix Cache.__setitem__ over-evicting when growing an existing key\n\nWhen getsizeof is set and an existing key's value grows, __currsize\nalready includes that key's old size, so reserving the full new size\ndouble-counts it and evicts an unrelated entry even though the updated\ncache would still fit within maxsize.\n\nReserve only the size delta instead, and recompute the reservation as a\nfull insert if popitem() happens to evict the key being updated.\n\nAdds a regression test covering all cache types.\n\nCloses #405", "tree": {"sha": "aec4480b254258a02402eee1237de5b8a22e677d", "url": "https://api.github.com/repos/tkem/cachetools/git/trees/aec4480b254258a02402eee1237de5b8a22e677d"}, "url": "https://api.github.com/repos/tkem/cachetools/git/commits/4dd976de71a0cb488f03719c2788b438e2f5ce1c", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/tkem/cachetools/commits/4dd976de71a0cb488f03719c2788b438e2f5ce1c", "html_url": "https://github.com/tkem/cachetools/commit/4dd976de71a0cb488f03719c2788b438e2f5ce1c", "comments_url": "https://api.github.com/repos/tkem/cachetools/commits/4dd976de71a0cb488f03719c2788b438e2f5ce1c/comments", "author": {"login": "Sanjays2402", "id": 51058514, "node_id": "MDQ6VXNlcjUxMDU4NTE0", "avatar_url": "https://avatars.githubusercontent.com/u/51058514?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sanjays2402", "html_url": "https://github.com/Sanjays2402", "followers_url": "https://api.github.com/users/Sanjays2402/followers", "following_url": "https://api.github.com/users/Sanjays2402/following{/other_user}", "gists_url": "https://api.github.com/users/Sanjays2402/gists{/gist_id}", "starred_url": "https://api.github.com/users/Sanjays2402/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Sanjays2402/subscriptions", "organizations_url": "https://api.github.com/users/Sanjays2402/orgs", "repos_url": "https://api.github.com/users/Sanjays2402/repos", "events_url": "https://api.github.com/users/Sanjays2402/events{/privacy}", "received_events_url": "https://api.github.com/users/Sanjays2402/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "Sanjays2402", "id": 51058514, "node_id": "MDQ6VXNlcjUxMDU4NTE0", "avatar_url": "https://avatars.githubusercontent.com/u/51058514?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sanjays2402", "html_url": "https://github.com/Sanjays2402", "followers_url": "https://api.github.com/users/Sanjays2402/followers", "following_url": "https://api.github.com/users/Sanjays2402/following{/other_user}", "gists_url": "https://api.github.com/users/Sanjays2402/gists{/gist_id}", "starred_url": "https://api.github.com/users/Sanjays2402/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Sanjays2402/subscriptions", "organizations_url": "https://api.github.com/users/Sanjays2402/orgs", "repos_url": "https://api.github.com/users/Sanjays2402/repos", "events_url": "https://api.github.com/users/Sanjays2402/events{/privacy}", "received_events_url": "https://api.github.com/users/Sanjays2402/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "13bb86a55e36e501cf0b3e4c35db516ed9409fd7", "url": "https://api.github.com/repos/tkem/cachetools/commits/13bb86a55e36e501cf0b3e4c35db516ed9409fd7", "html_url": "https://github.com/tkem/cachetools/commit/13bb86a55e36e501cf0b3e4c35db516ed9409fd7"}]}, {"sha": "b0ea1a4a0b38e1d3c60e802d171d776795c7a81b", "node_id": "C_kwDOARLDB9oAKGIwZWExYTRhMGIzOGUxZDNjNjBlODAyZDE3MWQ3NzY3OTVjN2E4MWI", "commit": {"author": {"name": "Sanjay Santhanam", "email": "51058514+Sanjays2402@users.noreply.github.com", "date": "2026-07-30T08:35:40Z"}, "committer": {"name": "Sanjay Santhanam", "email": "51058514+Sanjays2402@users.noreply.github.com", "date": "2026-07-30T08:35:40Z"}, "message": "Address review: drop changelog entry, split setitem branches\n\nUse separate insert/replace branches in Cache.__setitem__ so the\ninsert path does not re-check key presence on every eviction, and\nonly the replace path re-derives diffsize after popitem.\n\nKeep test keys aligned with their values and add replace cases for\nsame-size and smaller values.", "tree": {"sha": "63fe77ae20727762bda28a3d2094d7fbea16732e", "url": "https://api.github.com/repos/tkem/cachetools/git/trees/63fe77ae20727762bda28a3d2094d7fbea16732e"}, "url": "https://api.github.com/repos/tkem/cachetools/git/commits/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/tkem/cachetools/commits/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b", "html_url": "https://github.com/tkem/cachetools/commit/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b", "comments_url": "https://api.github.com/repos/tkem/cachetools/commits/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b/comments", "author": {"login": "Sanjays2402", "id": 51058514, "node_id": "MDQ6VXNlcjUxMDU4NTE0", "avatar_url": "https://avatars.githubusercontent.com/u/51058514?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sanjays2402", "html_url": "https://github.com/Sanjays2402", "followers_url": "https://api.github.com/users/Sanjays2402/followers", "following_url": "https://api.github.com/users/Sanjays2402/following{/other_user}", "gists_url": "https://api.github.com/users/Sanjays2402/gists{/gist_id}", "starred_url": "https://api.github.com/users/Sanjays2402/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Sanjays2402/subscriptions", "organizations_url": "https://api.github.com/users/Sanjays2402/orgs", "repos_url": "https://api.github.com/users/Sanjays2402/repos", "events_url": "https://api.github.com/users/Sanjays2402/events{/privacy}", "received_events_url": "https://api.github.com/users/Sanjays2402/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "Sanjays2402", "id": 51058514, "node_id": "MDQ6VXNlcjUxMDU4NTE0", "avatar_url": "https://avatars.githubusercontent.com/u/51058514?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sanjays2402", "html_url": "https://github.com/Sanjays2402", "followers_url": "https://api.github.com/users/Sanjays2402/followers", "following_url": "https://api.github.com/users/Sanjays2402/following{/other_user}", "gists_url": "https://api.github.com/users/Sanjays2402/gists{/gist_id}", "starred_url": "https://api.github.com/users/Sanjays2402/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Sanjays2402/subscriptions", "organizations_url": "https://api.github.com/users/Sanjays2402/orgs", "repos_url": "https://api.github.com/users/Sanjays2402/repos", "events_url": "https://api.github.com/users/Sanjays2402/events{/privacy}", "received_events_url": "https://api.github.com/users/Sanjays2402/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "4dd976de71a0cb488f03719c2788b438e2f5ce1c", "url": "https://api.github.com/repos/tkem/cachetools/commits/4dd976de71a0cb488f03719c2788b438e2f5ce1c", "html_url": "https://github.com/tkem/cachetools/commit/4dd976de71a0cb488f03719c2788b438e2f5ce1c"}]}], "files": [{"sha": "cbf9fe1d445324be4874b934a8e52fe1c708f15d", "filename": "src/cachetools/__init__.py", "status": "modified", "additions": 8, "deletions": 5, "changes": 13, "blob_url": "https://github.com/tkem/cachetools/blob/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b/src%2Fcachetools%2F__init__.py", "raw_url": "https://github.com/tkem/cachetools/raw/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b/src%2Fcachetools%2F__init__.py", "contents_url": "https://api.github.com/repos/tkem/cachetools/contents/src%2Fcachetools%2F__init__.py?ref=b0ea1a4a0b38e1d3c60e802d171d776795c7a81b", "patch": "@@ -79,13 +79,16 @@ def __setitem__(self, key, value):\n             raise ValueError(\"value size must be non-negative\")\n         if size > maxsize:\n             raise ValueError(\"value too large\")\n-        if key not in self.__data or self.__size[key] < size:\n-            while self.__currsize + size > maxsize:\n+        if key not in self.__data:\n+            diffsize = size\n+            while self.__currsize + diffsize > maxsize:\n                 self.popitem()\n-        if key in self.__data:\n-            diffsize = size - self.__size[key]\n         else:\n-            diffsize = size\n+            diffsize = size - self.__size[key]\n+            while self.__currsize + diffsize > maxsize:\n+                self.popitem()\n+                if key not in self.__data:\n+                    diffsize = size\n         self.__data[key] = value\n         self.__size[key] = size\n         self.__currsize += diffsize"}, {"sha": "1e53ee3be53c34cc0b847dcd1d8679b387406590", "filename": "tests/__init__.py", "status": "modified", "additions": 41, "deletions": 0, "changes": 41, "blob_url": "https://github.com/tkem/cachetools/blob/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b/tests%2F__init__.py", "raw_url": "https://github.com/tkem/cachetools/raw/b0ea1a4a0b38e1d3c60e802d171d776795c7a81b/tests%2F__init__.py", "contents_url": "https://api.github.com/repos/tkem/cachetools/contents/tests%2F__init__.py?ref=b0ea1a4a0b38e1d3c60e802d171d776795c7a81b", "patch": "@@ -284,6 +284,47 @@ def _test_getsizeof(self, cache):\n     def test_getsizeof_param(self):\n         self._test_getsizeof(self.Cache(maxsize=3, getsizeof=lambda x: x))\n \n+    def test_getsizeof_replace_grow(self):\n+        cache = self.Cache(maxsize=10, getsizeof=lambda x: x)\n+\n+        cache[3] = 3\n+        cache[4] = 4\n+        self.assertEqual(2, len(cache))\n+        self.assertEqual(7, cache.currsize)\n+\n+        # growing an existing entry must only reserve the additional size\n+        cache[4] = 7\n+        self.assertEqual(2, len(cache))\n+        self.assertEqual(10, cache.currsize)\n+        self.assertEqual(3, cache[3])\n+        self.assertEqual(7, cache[4])\n+\n+    def test_getsizeof_replace_same_size(self):\n+        cache = self.Cache(maxsize=10, getsizeof=lambda x: x)\n+\n+        cache[3] = 3\n+        cache[4] = 4\n+        self.assertEqual(7, cache.currsize)\n+\n+        cache[4] = 4\n+        self.assertEqual(2, len(cache))\n+        self.assertEqual(7, cache.currsize)\n+        self.assertEqual(3, cache[3])\n+        self.assertEqual(4, cache[4])\n+\n+    def test_getsizeof_replace_shrink(self):\n+        cache = self.Cache(maxsize=10, getsizeof=lambda x: x)\n+\n+        cache[3] = 3\n+        cache[4] = 4\n+        self.assertEqual(7, cache.currsize)\n+\n+        cache[4] = 1\n+        self.assertEqual(2, len(cache))\n+        self.assertEqual(4, cache.currsize)\n+        self.assertEqual(3, cache[3])\n+        self.assertEqual(1, cache[4])\n+\n     def test_getsizeof_negative(self):\n         cache = self.Cache(maxsize=3, getsizeof=lambda x: -1)\n "}]}