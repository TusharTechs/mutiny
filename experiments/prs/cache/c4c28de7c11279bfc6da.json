api.github.com/users/web-flow/orgs", "repos_url": "https://api.github.com/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "87d12578c3e558c57fbfbe663be63259c1fce56f", "url": "https://api.github.com/repos/more-itertools/more-itertools/commits/87d12578c3e558c57fbfbe663be63259c1fce56f", "html_url": "https://github.com/more-itertools/more-itertools/commit/87d12578c3e558c57fbfbe663be63259c1fce56f"}]}], "files": [{"sha": "2681798130b59028ff806177f1cba4285d29aed6", "filename": "docs/versions.rst", "status": "modified", "additions": 1, "deletions": 0, "changes": 1, "blob_url": "https://github.com/more-itertools/more-itertools/blob/e581766aecd209744efdc4cebf741fd6b23c865d/docs%2Fversions.rst", "raw_url": "https://github.com/more-itertools/more-itertools/raw/e581766aecd209744efdc4cebf741fd6b23c865d/docs%2Fversions.rst", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/docs%2Fversions.rst?ref=e581766aecd209744efdc4cebf741fd6b23c865d", "patch": "@@ -9,6 +9,7 @@ Unreleased\n ----------\n \n * Changes to existing functions:\n+    * :func:`constrained_batches` now raises ``ValueError`` for a nonpositive *max_count*.\n     * :func:`iter_index` was fixed to accept negative *start* and *stop* with general iterables (thanks to gaoflow)\n     * :func:`split_before`, :func:`split_after`, and :func:`split_when` no longer yield an empty list for an empty *iterable* when *maxsplit* is ``0``\n "}, {"sha": "d435c2ece11f9d1374b692ddb51bd9642da85a3e", "filename": "more_itertools/more.py", "status": "modified", "additions": 3, "deletions": 1, "changes": 4, "blob_url": "https://github.com/more-itertools/more-itertools/blob/e581766aecd209744efdc4cebf741fd6b23c865d/more_itertools%2Fmore.py", "raw_url": "https://github.com/more-itertools/more-itertools/raw/e581766aecd209744efdc4cebf741fd6b23c865d/more_itertools%2Fmore.py", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/more_itertools%2Fmore.py?ref=e581766aecd209744efdc4cebf741fd6b23c865d", "patch": "@@ -4938,7 +4938,7 @@ def constrained_batches(\n     [(b'12345', b'123'), (b'12345678', b'1', b'1'), (b'12', b'1')]\n \n     If a *max_count* is supplied, the number of items per batch is also\n-    limited:\n+    limited. It must be greater than zero:\n \n     >>> iterable = [b'12345', b'123', b'12345678', b'1', b'1', b'12', b'1']\n     >>> list(constrained_batches(iterable, 10, max_count = 2))\n@@ -4952,6 +4952,8 @@ def constrained_batches(\n     \"\"\"\n     if max_size <= 0:\n         raise ValueError('maximum size must be greater than zero')\n+    if max_count is not None and max_count <= 0:\n+        raise ValueError('maximum count must be greater than zero')\n \n     batch = []\n     batch_size = 0"}, {"sha": "cc412ff481fc8e4382cd95ba8ab0b2edb7912180", "filename": "tests/test_more.py", "status": "modified", "additions": 17, "deletions": 0, "changes": 17, "blob_url": "https://github.com/more-itertools/more-itertools/blob/e581766aecd209744efdc4cebf741fd6b23c865d/tests%2Ftest_more.py", "raw_url": "https://github.com/more-itertools/more-itertools/raw/e581766aecd209744efdc4cebf741fd6b23c865d/tests%2Ftest_more.py", "contents_url": "https://api.github.com/repos/more-itertools/more-itertools/contents/tests%2Ftest_more.py?ref=e581766aecd209744efdc4cebf741fd6b23c865d", "patch": "@@ -6117,6 +6117,23 @@ def test_max_count(self):\n         expected = [('1', '1'), ('12345678',), ('12345', '12345')]\n         self.assertEqual(actual, expected)\n \n+    def test_max_count_one(self):\n+        self.assertEqual(\n+            list(mi.constrained_batches(['', 'a', ''], 10, max_count=1)),\n+            [('',), ('a',), ('',)],\n+        )\n+\n+    def test_nonpositive_max_count(self):\n+        for max_count in (0, -1):\n+            for items in ([], ['a', 'b']):\n+                with self.subTest(max_count=max_count, items=items):\n+                    source = iter(items)\n+                    with self.assertRaisesRegex(\n+                        ValueError, 'maximum count must be greater than zero'\n+                    ):\n+                        list(mi.constrained_batches(source, 10, max_count))\n+                    self.assertEqual(list(source), items)\n+\n     def test_strict(self):\n         iterable = ['1', '123456789', '1']\n         size = 8"}]}